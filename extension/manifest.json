{
  "manifest_version": 3,
  "name": "Mia",
  "version": "0.5.1",
  "description": "Mia, your browser assistant: she and her bots read, compare and act on your tabs with you.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "unlimitedStorage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/mia-16.png",
      "32": "icons/mia-32.png",
      "48": "icons/mia-48.png",
      "128": "icons/mia-128.png"
    },
    "default_title": "Open Mia"
  },
  "icons": {
    "16": "icons/mia-16.png",
    "32": "icons/mia-32.png",
    "48": "icons/mia-48.png",
    "128": "icons/mia-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/*"
      ],
      "js": [
        "canvas_text.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "116",
  "commands": {
    "crop-ask": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Crop an area of a shared page and ask the bots about it"
    },
    "text-ask": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Ask the bots about the selected text"
    },
    "open-chat": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open Mia's chat in the side panel"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
