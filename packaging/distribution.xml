<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Ghost</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
  <domains enable_localSystem="true"/>
  <volume-check>
    <allowed-os-versions><os-version min="12.0"/></allowed-os-versions>
  </volume-check>
  <choices-outline><line choice="ghost"/></choices-outline>
  <choice id="ghost" visible="false"><pkg-ref id="com.ghost.multiplayer"/></choice>
  <pkg-ref id="com.ghost.multiplayer" version="@VERSION@" onConclusion="none">ghost.pkg</pkg-ref>
</installer-gui-script>
